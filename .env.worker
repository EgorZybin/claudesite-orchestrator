# Worker environment for the DOCKERIZED Celery worker (docker compose service `worker`).
# Layered on top of `.env` via env_file — paths/hosts here use the docker network
# and in-container mount points, NOT host paths.

DATABASE_URL=mysql+pymysql://claudesite:change_me@mysql:3306/claudesite
REDIS_URL=redis://redis:6379/0

# Idempotency TTL in seconds (default 604800 = 7d). Lower for dev/testing.
IDEMPOTENCY_TTL_SECONDS=86400

# Optional explicit Celery URLs (defaults to REDIS_URL when unset)
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# LLM provider: claude_remote — talks to the EU gateway over HTTPS.
# No local Claude CLI in the container; CLAUDE_CLI_ARGV is unused with claude_remote.
LLM_PROVIDER=claude_remote
CLAUDE_CLI_TIMEOUT_SECONDS=1800
CLAUDE_CLI_MAX_RETRIES=1

# claude_remote: EU gateway endpoint (nginx + self-signed cert; bearer token +
# iptables allowlist are the gate). CA bundle path is identical on host and in
# the container (secrets/ is bind-mounted at this same absolute path).
CLAUDE_GATEWAY_URL=https://94.131.118.182
CLAUDE_GATEWAY_TOKEN=3bec685ac4045e63198033ddf7b3b9c7f7fdbd1b635acbfaa8f7061daa5b6dc6
CLAUDE_GATEWAY_CA_BUNDLE=/root/claudesite-orchestrator/secrets/claude-gateway-ca.crt

# Optional text services
SMODIN_API_KEY=fj47d0NC4691nhcc2a284355FXbc71k386fcNuc4ffLn5f90qJfc58Diccf49laf88kPdf84Ate3e01yb797L2ad9dbr0102
SMODIN_HUMANIZE_URL=https://api.smodin.io/v1/rewrite/single
# SMODIN_LANGUAGE=auto   # auto-detect, либо en/ru/...
SMODIN_STRENGTH=4
# TURGENEV_API_KEY=
PIPELINE_DISABLE_SMODIN=false
PIPELINE_DISABLE_TURGENEV=true
PIPELINE_SOFT_FAIL_ADAPTERS=false

# Optional backup hook before bulk runs
# BULK_WORDPRESS_BACKUP_HOOK=/usr/local/bin/backup-example-wp.sh
# BULK_BACKUP_HOOK_TIMEOUT_SECONDS=3600

# Images / OpenAI-compatible text endpoint
OPENAI_API_KEY=sk-9sTRcLiSz4RSKf7ICErepA
OPENAI_BASE_URL=https://api.vsellm.ru/v1
OPENAI_IMAGE_TIMEOUT_SECONDS=180
# GEMINI_API_KEY=

# Site configs — mounted read-only at /app/sites.
SITES_CONFIG_ROOT=/app/sites

# === SMTP / form notifications ===
# SMTP_HOST empty => sending disabled (submissions still logged as no_destination).
# The old smoke-test value 127.0.0.1:18025 pointed at a host-local relay that is
# unreachable from inside the container — set this to a real relay to enable mail.
SMTP_HOST=
SMTP_PORT=18025
SMTP_USE_TLS=false
SMTP_FROM_DEFAULT=noreply@lead-hunter.ru
SMTP_TIMEOUT_SECONDS=5
