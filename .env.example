# Base env for API container (docker-compose).
# Worker uses separate file: `.env.worker` (see build/.env.worker.example).

# MySQL (SQLAlchemy URL) for docker-compose network
DATABASE_URL=mysql+pymysql://claudesite:change_me@mysql:3306/claudesite

REDIS_URL=redis://redis:6379/0

# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

API_HOST=127.0.0.1
API_PORT=8000
# REACT_RENDERER_URL=http://renderer:3000/internal/render
# REACT_RENDERER_TIMEOUT_SECONDS=2.5
# REACT_RENDERER_FAIL_OPEN=true

# Если задан — защищенные API-роуты требуют заголовок:
# X-API-Key: <token>
# ORCHESTRATOR_API_TOKEN=

# Per-site YAML root: <SITES_CONFIG_ROOT>/<slug>/config.yaml (default: ./sites)
# SITES_CONFIG_ROOT=/etc/claudesite/sites

