# Host-side worker environment (standalone, no dependency on `.env`).
# Use host-exposed ports from docker-compose.

DATABASE_URL=mysql+pymysql://claudesite:change_me@127.0.0.1:3306/claudesite
REDIS_URL=redis://127.0.0.1:6379/0
SITES_CONFIG_ROOT=/root/claudesite-orchestrator/sites

# Optional explicit Celery URLs (defaults to REDIS_URL when unset)
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Host has local Claude CLI
# LLM provider switch:
# LLM_PROVIDER=claude_local   # uses CLAUDE_CLI_ARGV
# LLM_PROVIDER=openai         # uses OPENAI_API_KEY + OPENAI_BASE_URL + LLM_OPENAI_MODEL
# LLM_OPENAI_MODEL=openai/gpt-5
# LLM_OPENAI_TIMEOUT_SECONDS=180
CLAUDE_CLI_ARGV=claude
CLAUDE_CLI_TIMEOUT_SECONDS=600
CLAUDE_CLI_MAX_RETRIES=3

# Optional text services
# SMODIN_API_KEY=
# SMODIN_HUMANIZE_URL=https://api.example.invalid/humanize
# TURGENEV_API_KEY=
# TURGENEV_ANALYZE_URL=https://api.example.invalid/analyze
# TURGENEV_AUTOCORRECT_URL=

# Optional tuning/feature flags
# ADAPTER_HTTP_MAX_RETRIES=3
# ADAPTER_DLQ_PATH=/var/log/claudesite/adapter_dlq.jsonl

# После исчерпания HTTP-retry: true = не валить пайплайн (пропуск humanize / manual_review вместо FAILED)
PIPELINE_SOFT_FAIL_ADAPTERS=false # false = валить пайплайн на ошибку адаптера true = пропустить humanize / manual_review вместо FAILED

# Optional tuning/feature flags
# PIPELINE_DISABLE_SMODIN=false
# PIPELINE_DISABLE_TURGENEV=false

# Optional backup hook before bulk runs
# BULK_WORDPRESS_BACKUP_HOOK=/usr/local/bin/backup-example-wp.sh
# BULK_BACKUP_HOOK_TIMEOUT_SECONDS=3600

# Images providers (if enabled in site config)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_TIMEOUT_SECONDS=180
# GEMINI_API_KEY=
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# GEMINI_IMAGE_TIMEOUT_SECONDS=180

# === SMTP for form-submission notifications ===
# Если SMTP_HOST не задан, заявки всё равно пишутся в БД, но писем не шлём
# (status='no_destination'). Подойдёт любой провайдер: Mailgun / Postmark /
# Brevo / SES / Gmail-SMTP / локальный Postfix.
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=postmaster@your-mg-domain
# SMTP_PASSWORD=
# SMTP_TIMEOUT_SECONDS=15
#
# Адрес "From:" во всех письмах. Это технический отправитель, не получатель.
# Обязан совпадать с верифицированным доменом SMTP-провайдера (SPF/DKIM),
# иначе провайдер отобьёт письмо. Reply-To выставляется динамически из поля
# email формы — поэтому ответы владельца сайта летят клиенту, а не сюда.
# SMTP_FROM_DEFAULT=noreply@your-verified-domain.com
